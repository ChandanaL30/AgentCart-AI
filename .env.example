# AgentCart AI - Environment Configuration Example
# Copy this file to .env or .env.local for local development.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL Database Connection URL (Prisma)
# Optional for local demo mode (falls back to in-memory session/run/proposal/checkout stores)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentcart_ai?schema=public"

# Cryptographic secret for signing and validating HttpOnly guest session cookies (32+ chars)
SESSION_SECRET="agentcart_super_secure_random_session_secret_change_in_production_32chars"

# -----------------------------------------------------------------------------
# PayPal Sandbox Configuration (Orders API v2)
# -----------------------------------------------------------------------------
# 1. Log in to https://developer.paypal.com/dashboard/
# 2. Navigate to "Apps & Credentials" -> Sandbox tab.
# 3. Create a REST API app to obtain your Sandbox Client ID and Secret.
# 4. Under "Testing Tools" -> "Sandbox Accounts", ensure you have a Personal (Buyer) account.
# 5. When placeholder credentials are used, AgentCart runs in deterministic Sandbox Simulation mode.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sandbox_paypal_client_id_placeholder"
PAYPAL_CLIENT_SECRET="sandbox_paypal_client_secret_placeholder"
PAYPAL_ENVIRONMENT="sandbox"

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Supported options: "mock" (offline/deterministic demo), "openai", "gemini", "anthropic"
LLM_PROVIDER="mock"

# Optional provider API keys (required only if LLM_PROVIDER is set to the respective service)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

