# =============================================================================
# AgentCart AI - Environment Configuration Template
# Safe placeholder values only. Never commit real credentials to version control.
# =============================================================================

# Application Base URL (Set to your Render live domain in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Cryptographic Secret for signing HttpOnly guest session cookies
# In production on Render, set this to a permanent 32+ character random string.
SESSION_SECRET="agentcart_super_secure_random_session_secret_change_in_production_32chars"

# -----------------------------------------------------------------------------
# Database Configuration (Optional)
# -----------------------------------------------------------------------------
# Optional PostgreSQL connection URL.
# If omitted or left empty, AgentCart AI automatically runs in in-memory mode.
# DATABASE_URL="postgresql://user:password@hostname:5432/agentcart_ai?sslmode=require"
DATABASE_URL=""

# -----------------------------------------------------------------------------
# PayPal Sandbox Configuration (Orders API v2)
# -----------------------------------------------------------------------------
# Obtain from https://developer.paypal.com/dashboard/ -> Apps & Credentials (Sandbox)
# If left as placeholders, AgentCart AI runs in deterministic Sandbox Simulation mode.
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sandbox_paypal_client_id_placeholder"
PAYPAL_CLIENT_SECRET="sandbox_paypal_client_secret_placeholder"
PAYPAL_ENVIRONMENT="sandbox"

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Supported options: "mock" (offline/deterministic demo), "gemini", "openai", "anthropic"
LLM_PROVIDER="mock"

# Provider API Keys (required only if LLM_PROVIDER is set to the respective service)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
